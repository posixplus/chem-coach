[
  {"topic_id": "m1-linear", "qtype": "math", "prompt": "Find the slope of the line through $(2, -3)$ and $(6, 5)$.", "choices": null, "answer": "2", "meta": {"kind": "number", "answer_tex": "2"}, "graph": null, "calc": "no-calc", "hint": "Slope is rise over run: $\\dfrac{y_2 - y_1}{x_2 - x_1}$.", "explanation": "$m = \\dfrac{5 - (-3)}{6 - 2} = \\dfrac{8}{4} = 2$.", "difficulty": 1, "wrong": []},
  {"topic_id": "m1-linear", "qtype": "math", "prompt": "Find the slope of the line through $(-4, 7)$ and $(2, -2)$.", "choices": null, "answer": "-3/2", "meta": {"kind": "number", "answer_tex": "-\\tfrac{3}{2}"}, "graph": null, "calc": "no-calc", "hint": "Subtract in the same order on top and bottom.", "explanation": "$m = \\dfrac{-2 - 7}{2 - (-4)} = \\dfrac{-9}{6} = -\\dfrac{3}{2}$.", "difficulty": 1, "wrong": ["3/2", "-2/3"]},
  {"topic_id": "m1-linear", "qtype": "math", "prompt": "Write the equation of the line with slope $-3$ that passes through $(2, 1)$, in slope-intercept form.", "choices": null, "answer": "y = -3x + 7", "meta": {"kind": "equation", "answer_tex": "y = -3x + 7"}, "graph": null, "calc": "no-calc", "hint": "Point-slope first: $y - y_1 = m(x - x_1)$, then solve for $y$.", "explanation": "$y - 1 = -3(x - 2)$, so $y = -3x + 6 + 1 = -3x + 7$.", "difficulty": 1, "wrong": ["y = -3x + 1", "y = -3x - 5"]},
  {"topic_id": "m1-linear", "qtype": "math", "prompt": "Write the equation of the line through $(1, 2)$ and $(3, 8)$.", "choices": null, "answer": "y = 3x - 1", "meta": {"kind": "equation", "answer_tex": "y = 3x - 1"}, "graph": null, "calc": "no-calc", "hint": "Find the slope first, then use either point.", "explanation": "$m = \\dfrac{8 - 2}{3 - 1} = 3$. $y - 2 = 3(x - 1) \\Rightarrow y = 3x - 1$.", "difficulty": 2, "wrong": []},
  {"topic_id": "m1-linear", "qtype": "math", "prompt": "Write the equation of the line parallel to $y = -2x + 1$ that passes through $(-4, 0)$.", "choices": null, "answer": "y = -2x - 8", "meta": {"kind": "equation", "answer_tex": "y = -2x - 8"}, "graph": null, "calc": "no-calc", "hint": "Parallel lines have the same slope.", "explanation": "Slope $-2$. $y - 0 = -2(x + 4) \\Rightarrow y = -2x - 8$.", "difficulty": 2, "wrong": ["y = -2x + 1", "y = 0.5x + 2", "y = -2x + 8"]},
  {"topic_id": "m1-linear", "qtype": "math", "prompt": "Write the equation of the line perpendicular to $y = -2x + 1$ that passes through the origin.", "choices": null, "answer": "y = x/2", "meta": {"kind": "equation", "answer_tex": "y = \\tfrac{1}{2}x"}, "graph": null, "calc": "no-calc", "hint": "Perpendicular slopes are negative reciprocals: flip the fraction and change the sign.", "explanation": "The negative reciprocal of $-2$ is $\\tfrac{1}{2}$. Through $(0, 0)$ the intercept is 0, so $y = \\tfrac{1}{2}x$.", "difficulty": 2, "wrong": ["y = 2x", "y = -x/2", "y = -2x"]},
  {"topic_id": "m1-linear", "qtype": "math", "prompt": "Find the equation of the line perpendicular to $3x - 4y = 12$ through $(3, -1)$.", "choices": null, "answer": "y = -4x/3 + 3", "meta": {"kind": "equation", "answer_tex": "y = -\\tfrac{4}{3}x + 3"}, "graph": null, "calc": "no-calc", "hint": "Solve $3x - 4y = 12$ for $y$ to read its slope first.", "explanation": "$y = \\tfrac{3}{4}x - 3$, so the perpendicular slope is $-\\tfrac{4}{3}$. $y + 1 = -\\tfrac{4}{3}(x - 3) \\Rightarrow y = -\\tfrac{4}{3}x + 3$.", "difficulty": 3, "wrong": ["y = 3x/4 - 13/4", "y = 4x/3 - 5"]},
  {"topic_id": "m1-linear", "qtype": "mcq", "prompt": "Fill in the blank: the slope of a ______ line is zero.", "choices": ["horizontal", "vertical", "perpendicular", "diagonal"], "answer": "horizontal", "meta": null, "graph": null, "calc": "no-calc", "hint": "Zero rise, any run.", "explanation": "A horizontal line has rise 0, so $m = 0$. A vertical line has run 0, so its slope is undefined.", "difficulty": 1, "wrong": []},
  {"topic_id": "m1-linear", "qtype": "mcq", "prompt": "Two lines are ______ if they intersect to form right angles.", "choices": ["perpendicular", "parallel", "collinear", "congruent"], "answer": "perpendicular", "meta": null, "graph": null, "calc": "no-calc", "hint": "Right angles.", "explanation": "Perpendicular lines meet at $90^\\circ$; their slopes multiply to $-1$.", "difficulty": 1, "wrong": []},
  {"topic_id": "m1-linear", "qtype": "mcq", "prompt": "What is the slope of the line $x = 4$?", "choices": ["undefined", "0", "4", "1"], "answer": "undefined", "meta": null, "graph": null, "calc": "no-calc", "hint": "$x = 4$ is a vertical line. What is its run?", "explanation": "Vertical line: run is 0, and you cannot divide by 0, so the slope is undefined.", "difficulty": 1, "wrong": []},
  {"topic_id": "m1-linear", "qtype": "math", "prompt": "Find the $x$-intercept of $2x + 5y = 10$.", "choices": null, "answer": "(5, 0)", "meta": {"kind": "point", "answer_tex": "(5, 0)"}, "graph": null, "calc": "no-calc", "hint": "On the $x$-axis, $y = 0$.", "explanation": "Set $y = 0$: $2x = 10$, $x = 5$. The intercept is $(5, 0)$.", "difficulty": 1, "wrong": ["(0, 2)", "(2, 0)"]},
  {"topic_id": "m1-linear", "qtype": "math", "prompt": "Write the equation of the horizontal line through $(3, -7)$.", "choices": null, "answer": "y = -7", "meta": {"kind": "equation", "answer_tex": "y = -7"}, "graph": null, "calc": "no-calc", "hint": "Horizontal lines are $y = $ a constant.", "explanation": "Every point on a horizontal line has the same $y$, so $y = -7$.", "difficulty": 1, "wrong": []},
  {"topic_id": "m1-linear", "qtype": "mcq", "prompt": "How are the lines $y = 2x + 3$ and $4x - 2y = 7$ related?", "choices": ["parallel", "perpendicular", "the same line", "neither"], "answer": "parallel", "meta": null, "graph": null, "calc": "no-calc", "hint": "Rewrite the second line in slope-intercept form.", "explanation": "$4x - 2y = 7 \\Rightarrow y = 2x - \\tfrac{7}{2}$. Same slope 2, different intercepts, so parallel.", "difficulty": 2, "wrong": []},
  {"topic_id": "m1-linear", "qtype": "math", "prompt": "Rewrite $y - 4 = \\tfrac{2}{3}(x + 6)$ in slope-intercept form.", "choices": null, "answer": "y = 2x/3 + 8", "meta": {"kind": "equation", "answer_tex": "y = \\tfrac{2}{3}x + 8"}, "graph": null, "calc": "no-calc", "hint": "Distribute, then add 4 to both sides.", "explanation": "$y - 4 = \\tfrac{2}{3}x + 4 \\Rightarrow y = \\tfrac{2}{3}x + 8$.", "difficulty": 2, "wrong": ["y = 2x/3 + 10", "y = 2x/3 + 4"]},
  {"topic_id": "m1-quadratics", "qtype": "math", "prompt": "Factor completely: $x^2 + 7x + 12$", "choices": null, "answer": "(x+3)(x+4)", "meta": {"kind": "expr", "answer_tex": "\\left(x + 3\\right) \\left(x + 4\\right)", "placeholder": "A product, e.g. (x + 2)(x - 5)", "form": "factored"}, "graph": null, "calc": "no-calc", "hint": "Two numbers that multiply to 12 and add to 7.", "explanation": "$3 \\cdot 4 = 12$ and $3 + 4 = 7$, so $(x + 3)(x + 4)$.", "difficulty": 1, "wrong": ["x^2+7x+12", "(x+2)(x+6)"]},
  {"topic_id": "m1-quadratics", "qtype": "math", "prompt": "Factor completely: $x^2 - 5x - 14$", "choices": null, "answer": "(x-7)(x+2)", "meta": {"kind": "expr", "answer_tex": "\\left(x - 7\\right) \\left(x + 2\\right)", "placeholder": "A product, e.g. (x + 2)(x - 5)", "form": "factored"}, "graph": null, "calc": "no-calc", "hint": "Multiply to $-14$, add to $-5$.", "explanation": "$-7 \\cdot 2 = -14$ and $-7 + 2 = -5$: $(x - 7)(x + 2)$.", "difficulty": 1, "wrong": ["(x+7)(x-2)"]},
  {"topic_id": "m1-quadratics", "qtype": "math", "prompt": "Factor completely: $6x^2 + 7x - 3$", "choices": null, "answer": "(3x-1)(2x+3)", "meta": {"kind": "expr", "answer_tex": "\\left(2 x + 3\\right) \\left(3 x - 1\\right)", "placeholder": "A product, e.g. (x + 2)(x - 5)", "form": "factored"}, "graph": null, "calc": "no-calc", "hint": "AC method: $6 \\cdot (-3) = -18$. Which pair multiplies to $-18$ and adds to $7$?", "explanation": "$9$ and $-2$. $6x^2 + 9x - 2x - 3 = 3x(2x + 3) - 1(2x + 3) = (3x - 1)(2x + 3)$.", "difficulty": 3, "wrong": []},
  {"topic_id": "m1-quadratics", "qtype": "math", "prompt": "Factor completely: $4x^2 - 25$", "choices": null, "answer": "(2x-5)(2x+5)", "meta": {"kind": "expr", "answer_tex": "\\left(2 x - 5\\right) \\left(2 x + 5\\right)", "placeholder": "A product, e.g. (x + 2)(x - 5)", "form": "factored"}, "graph": null, "calc": "no-calc", "hint": "Difference of squares: $a^2 - b^2 = (a - b)(a + b)$.", "explanation": "$4x^2 = (2x)^2$ and $25 = 5^2$, so $(2x - 5)(2x + 5)$.", "difficulty": 1, "wrong": ["(2x-5)^2"]},
  {"topic_id": "m1-quadratics", "qtype": "math", "prompt": "Factor completely: $3x^3 - 12x$", "choices": null, "answer": "3x(x-2)(x+2)", "meta": {"kind": "expr", "answer_tex": "3 x \\left(x - 2\\right) \\left(x + 2\\right)", "placeholder": "A product, e.g. (x + 2)(x - 5)", "form": "factored"}, "graph": null, "calc": "no-calc", "hint": "Take out the GCF first, then look again.", "explanation": "$3x(x^2 - 4) = 3x(x - 2)(x + 2)$. Stopping at $3x(x^2 - 4)$ is not complete.", "difficulty": 2, "wrong": ["3x(x^2-4)"]},
  {"topic_id": "m1-quadratics", "qtype": "math", "prompt": "Factor completely: $x^3 - 8$", "choices": null, "answer": "(x-2)(x^2+2x+4)", "meta": {"kind": "expr", "answer_tex": "\\left(x - 2\\right) \\left(x^{2} + 2 x + 4\\right)", "placeholder": "A product, e.g. (x + 2)(x - 5)", "form": "factored"}, "graph": null, "calc": "no-calc", "hint": "Difference of cubes: $a^3 - b^3 = (a - b)(a^2 + ab + b^2)$.", "explanation": "$a = x$, $b = 2$: $(x - 2)(x^2 + 2x + 4)$. The quadratic factor does not factor further.", "difficulty": 3, "wrong": []},
  {"topic_id": "m1-quadratics", "qtype": "math", "prompt": "Factor completely: $2x^2 - 8x + 8$", "choices": null, "answer": "2(x-2)^2", "meta": {"kind": "expr", "answer_tex": "2 \\left(x - 2\\right)^{2}", "placeholder": "A product, e.g. (x + 2)(x - 5)", "form": "factored"}, "graph": null, "calc": "no-calc", "hint": "GCF first.", "explanation": "$2(x^2 - 4x + 4) = 2(x - 2)^2$.", "difficulty": 2, "wrong": ["2(x^2-4x+4)"]},
  {"topic_id": "m1-quadratics", "qtype": "math", "prompt": "Solve $x^2 - 5x - 14 = 0$.", "choices": null, "answer": "7, -2", "meta": {"kind": "set", "answer_tex": "x = 7,\\ x = -2"}, "graph": null, "calc": "no-calc", "hint": "Factor, then set each factor to zero.", "explanation": "$(x - 7)(x + 2) = 0$, so $x = 7$ or $x = -2$.", "difficulty": 1, "wrong": ["-7, 2", "7"]},
  {"topic_id": "m1-quadratics", "qtype": "math", "prompt": "Complete the square to write $x^2 + 6x + 5$ in vertex form $a(x - h)^2 + k$.", "choices": null, "answer": "(x+3)^2 - 4", "meta": {"kind": "expr", "answer_tex": "(x+3)^2 - 4", "placeholder": "e.g. (x + 1)^2 - 3", "form": "vertex"}, "graph": null, "calc": "no-calc", "hint": "Half the $x$-coefficient, squared, is what you add and subtract.", "explanation": "Half of 6 is 3, $3^2 = 9$: $x^2 + 6x + 9 - 9 + 5 = (x + 3)^2 - 4$.", "difficulty": 2, "wrong": ["(x+3)^2+5", "x^2+6x+5", "(x-3)^2-4"]},
  {"topic_id": "m1-quadratics", "qtype": "math", "prompt": "Complete the square to write $x^2 - 8x + 3$ in vertex form $a(x - h)^2 + k$.", "choices": null, "answer": "(x-4)^2 - 13", "meta": {"kind": "expr", "answer_tex": "(x-4)^2 - 13", "placeholder": "e.g. (x + 1)^2 - 3", "form": "vertex"}, "graph": null, "calc": "no-calc", "hint": "Half the $x$-coefficient, squared, is what you add and subtract.", "explanation": "Half of $-8$ is $-4$, $(-4)^2 = 16$: $(x - 4)^2 - 16 + 3 = (x - 4)^2 - 13$.", "difficulty": 2, "wrong": ["(x-4)^2+3", "(x+4)^2-13"]},
  {"topic_id": "m1-quadratics", "qtype": "math", "prompt": "Complete the square to write $2x^2 + 12x + 7$ in vertex form $a(x - h)^2 + k$.", "choices": null, "answer": "2(x+3)^2 - 11", "meta": {"kind": "expr", "answer_tex": "2(x+3)^2 - 11", "placeholder": "e.g. (x + 1)^2 - 3", "form": "vertex"}, "graph": null, "calc": "no-calc", "hint": "Half the $x$-coefficient, squared, is what you add and subtract.", "explanation": "Factor 2 out of the $x$ terms: $2(x^2 + 6x) + 7 = 2(x^2 + 6x + 9) - 18 + 7 = 2(x + 3)^2 - 11$.", "difficulty": 3, "wrong": ["2(x+3)^2-2", "2(x+3)^2+7"]},
  {"topic_id": "m1-quadratics", "qtype": "math", "prompt": "Find the vertex of $y = x^2 - 8x + 3$.", "choices": null, "answer": "(4, -13)", "meta": {"kind": "point", "answer_tex": "(4, -13)"}, "graph": null, "calc": "no-calc", "hint": "Vertex form $a(x - h)^2 + k$ has vertex $(h, k)$, or use $x = -\\tfrac{b}{2a}$.", "explanation": "$(x - 4)^2 - 13$, so the vertex is $(4, -13)$.", "difficulty": 2, "wrong": ["(-4, -13)", "(4, 3)"]},
  {"topic_id": "m1-quadratics", "qtype": "math", "prompt": "Solve $x^2 + 4x - 1 = 0$ by completing the square. Give exact answers.", "choices": null, "answer": "-2 + sqrt(5), -2 - sqrt(5)", "meta": {"kind": "set", "answer_tex": "x = -2 \\pm \\sqrt{5}", "placeholder": "e.g. x = 3 ± √2"}, "graph": null, "calc": "no-calc", "hint": "Move the constant: $x^2 + 4x = 1$. Add $\\left(\\tfrac{4}{2}\\right)^2$ to both sides.", "explanation": "$x^2 + 4x + 4 = 5 \\Rightarrow (x + 2)^2 = 5 \\Rightarrow x + 2 = \\pm\\sqrt{5} \\Rightarrow x = -2 \\pm \\sqrt{5}$.", "difficulty": 3, "wrong": ["2 ± sqrt(5)", "-2 + sqrt(5)"]},
  {"topic_id": "m1-quadratics", "qtype": "math", "prompt": "What number completes the square: $x^2 - 10x + \\_\\_\\_$ ?", "choices": null, "answer": "25", "meta": {"kind": "number", "answer_tex": "25"}, "graph": null, "calc": "no-calc", "hint": "Take half of $-10$ and square it.", "explanation": "$\\left(\\tfrac{-10}{2}\\right)^2 = (-5)^2 = 25$, giving $(x - 5)^2$.", "difficulty": 1, "wrong": ["-25", "100", "5"]},
  {"topic_id": "m1-quadratics", "qtype": "math", "prompt": "Solve $2x^2 + 3x - 2 = 0$.", "choices": null, "answer": "1/2, -2", "meta": {"kind": "set", "answer_tex": "x = \\tfrac{1}{2},\\ x = -2"}, "graph": null, "calc": "no-calc", "hint": "AC method: $2 \\cdot (-2) = -4$. Pair that adds to 3?", "explanation": "$(2x - 1)(x + 2) = 0$, so $x = \\tfrac{1}{2}$ or $x = -2$.", "difficulty": 2, "wrong": ["-1/2, 2", "2, -1/2"]},
  {"topic_id": "m1-exponents", "qtype": "math", "prompt": "Write $0.0000456$ in scientific notation.", "choices": null, "answer": "4.56e-5", "meta": {"kind": "number", "answer_tex": "4.56 \\times 10^{-5}", "placeholder": "e.g. 3.2 × 10^-4", "form": "sci"}, "graph": null, "calc": "no-calc", "hint": "Move the decimal until one non-zero digit is in front. Small numbers get negative exponents.", "explanation": "The decimal moves 5 places right: $4.56 \\times 10^{-5}$.", "difficulty": 1, "wrong": ["4.56 x 10^5", "45.6 x 10^-6", "0.456e-4"]},
  {"topic_id": "m1-exponents", "qtype": "math", "prompt": "Write $78{,}000{,}000$ in scientific notation.", "choices": null, "answer": "7.8e7", "meta": {"kind": "number", "answer_tex": "7.8 \\times 10^{7}", "placeholder": "e.g. 3.2 × 10^-4", "form": "sci"}, "graph": null, "calc": "no-calc", "hint": "Count how many places the decimal moves left.", "explanation": "$78{,}000{,}000 = 7.8 \\times 10^{7}$.", "difficulty": 1, "wrong": ["78 x 10^6", "7.8 x 10^6"]},
  {"topic_id": "m1-exponents", "qtype": "math", "prompt": "Simplify $\\dfrac{1.4 \\times 10^{4}}{0.2 \\times 10^{2}}$. Answer in scientific notation.", "choices": null, "answer": "7e2", "meta": {"kind": "number", "answer_tex": "7 \\times 10^{2}", "placeholder": "e.g. 3.2 × 10^-4", "form": "sci"}, "graph": null, "calc": "no-calc", "hint": "Divide the numbers, subtract the exponents.", "explanation": "$\\tfrac{1.4}{0.2} = 7$, $10^{4-2} = 10^2$: $7 \\times 10^{2}$.", "difficulty": 2, "wrong": ["700", "7 x 10^6"]},
  {"topic_id": "m1-exponents", "qtype": "math", "prompt": "Simplify $\\dfrac{3.3 \\times 10^{-3}}{1.1 \\times 10^{-5}}$. Answer in scientific notation.", "choices": null, "answer": "3e2", "meta": {"kind": "number", "answer_tex": "3 \\times 10^{2}", "placeholder": "e.g. 3.2 × 10^-4", "form": "sci"}, "graph": null, "calc": "no-calc", "hint": "Subtract exponents carefully: $-3 - (-5)$.", "explanation": "$\\tfrac{3.3}{1.1} = 3$ and $10^{-3-(-5)} = 10^{2}$: $3 \\times 10^{2}$.", "difficulty": 2, "wrong": ["3 x 10^-8", "300"]},
  {"topic_id": "m1-exponents", "qtype": "math", "prompt": "Simplify $(2 \\times 10^{4})(4 \\times 10^{-5})$. Answer in scientific notation.", "choices": null, "answer": "8e-1", "meta": {"kind": "number", "answer_tex": "8 \\times 10^{-1}", "placeholder": "e.g. 3.2 × 10^-4", "form": "sci"}, "graph": null, "calc": "no-calc", "hint": "Multiply the numbers, add the exponents.", "explanation": "$2 \\cdot 4 = 8$ and $10^{4 + (-5)} = 10^{-1}$: $8 \\times 10^{-1}$ (which equals 0.8).", "difficulty": 2, "wrong": ["4/5", "0.8", "8 x 10^-20"]},
  {"topic_id": "m1-exponents", "qtype": "math", "prompt": "Simplify $(7 \\times 10^{3})(3 \\times 10^{-1})$. Answer in scientific notation.", "choices": null, "answer": "2.1e3", "meta": {"kind": "number", "answer_tex": "2.1 \\times 10^{3}", "placeholder": "e.g. 3.2 × 10^-4", "form": "sci"}, "graph": null, "calc": "no-calc", "hint": "After multiplying, check the number in front is between 1 and 10.", "explanation": "$7 \\cdot 3 = 21$ and $10^{3 - 1} = 10^2$, so $21 \\times 10^2$. That is not finished: $21 = 2.1 \\times 10^1$, giving $2.1 \\times 10^{3}$.", "difficulty": 2, "wrong": ["21 x 10^2", "2100", "2.1 x 10^2"]},
  {"topic_id": "m1-exponents", "qtype": "math", "prompt": "Simplify $\\dfrac{4x^5}{2x^{-3}}$.", "choices": null, "answer": "2x^8", "meta": {"kind": "expr", "answer_tex": "2x^{8}", "domain": [0.5, 3]}, "graph": null, "calc": "no-calc", "hint": "Dividing: subtract exponents. Subtracting a negative adds.", "explanation": "$\\tfrac{4}{2} = 2$ and $x^{5 - (-3)} = x^{8}$: $2x^{8}$.", "difficulty": 2, "wrong": ["2x^2", "2x^(-15)"]},
  {"topic_id": "m1-exponents", "qtype": "math", "prompt": "Simplify $(3x^2)^3$.", "choices": null, "answer": "27x^6", "meta": {"kind": "expr", "answer_tex": "27x^{6}", "domain": [0.5, 3]}, "graph": null, "calc": "no-calc", "hint": "The power applies to the 3 and to $x^2$.", "explanation": "$3^3 = 27$ and $(x^2)^3 = x^6$: $27x^6$.", "difficulty": 1, "wrong": ["9x^6", "3x^6", "27x^5"]},
  {"topic_id": "m1-exponents", "qtype": "math", "prompt": "Evaluate $8^{2/3}$ without a calculator.", "choices": null, "answer": "4", "meta": {"kind": "number", "answer_tex": "4"}, "graph": null, "calc": "no-calc", "hint": "Denominator is the root, numerator is the power: $\\left(\\sqrt[3]{8}\\right)^2$.", "explanation": "$\\sqrt[3]{8} = 2$ and $2^2 = 4$.", "difficulty": 2, "wrong": ["16/3", "5.33"]},
  {"topic_id": "m1-exponents", "qtype": "math", "prompt": "Evaluate $16^{-3/4}$ without a calculator.", "choices": null, "answer": "1/8", "meta": {"kind": "number", "answer_tex": "\\tfrac{1}{8}"}, "graph": null, "calc": "no-calc", "hint": "Negative exponent means reciprocal. Then fourth root, then cube.", "explanation": "$16^{-3/4} = \\dfrac{1}{(\\sqrt[4]{16})^3} = \\dfrac{1}{2^3} = \\dfrac{1}{8}$.", "difficulty": 3, "wrong": ["8", "-8", "-12"]},
  {"topic_id": "m1-logs", "qtype": "math", "prompt": "Evaluate $\\log_2 16 - \\log_3 81$.", "choices": null, "answer": "0", "meta": {"kind": "number", "answer_tex": "0"}, "graph": null, "calc": "no-calc", "hint": "Ask: 2 to what power is 16? 3 to what power is 81?", "explanation": "$\\log_2 16 = 4$ and $\\log_3 81 = 4$, so $4 - 4 = 0$.", "difficulty": 1, "wrong": []},
  {"topic_id": "m1-logs", "qtype": "math", "prompt": "Evaluate $\\log_5 125 + \\log_4 16 - \\log_2 32$.", "choices": null, "answer": "0", "meta": {"kind": "number", "answer_tex": "0"}, "graph": null, "calc": "no-calc", "hint": "Evaluate each log separately first.", "explanation": "$3 + 2 - 5 = 0$.", "difficulty": 1, "wrong": []},
  {"topic_id": "m1-logs", "qtype": "math", "prompt": "Solve $\\log_9 \\tfrac{1}{9} = x$.", "choices": null, "answer": "-1", "meta": {"kind": "number", "answer_tex": "x = -1"}, "graph": null, "calc": "no-calc", "hint": "Rewrite as $9^x = \\tfrac{1}{9}$.", "explanation": "$9^{-1} = \\tfrac{1}{9}$, so $x = -1$.", "difficulty": 1, "wrong": ["1", "1/9"]},
  {"topic_id": "m1-logs", "qtype": "math", "prompt": "Solve $\\log_3 3 + \\log_2 8 = x$.", "choices": null, "answer": "4", "meta": {"kind": "number", "answer_tex": "x = 4"}, "graph": null, "calc": "no-calc", "hint": "Each log is a small whole number.", "explanation": "$1 + 3 = 4$.", "difficulty": 1, "wrong": []},
  {"topic_id": "m1-logs", "qtype": "math", "prompt": "Solve $\\log_9 (6x + 7) = 2$.", "choices": null, "answer": "37/3", "meta": {"kind": "number", "answer_tex": "x = \\tfrac{37}{3}"}, "graph": null, "calc": "no-calc", "hint": "Rewrite in exponential form: $9^2 = 6x + 7$.", "explanation": "$6x + 7 = 81 \\Rightarrow 6x = 74 \\Rightarrow x = \\tfrac{74}{6} = \\tfrac{37}{3}$.", "difficulty": 2, "wrong": ["74/3", "-5/6", "12"]},
